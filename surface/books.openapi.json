{
  "openapi": "3.1.0",
  "info": {
    "title": "openbooks books",
    "version": "1",
    "description": "The operations mounted under books."
  },
  "paths": {
    "/books/{org}/members": {
      "get": {
        "operationId": "members",
        "description": "Lists the company's members by email, a page at a time.",
        "x-openbooks-word": "read",
        "x-openbooks-tool": true,
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The company the operation is on.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "The cursor from the last page's next; absent for the first page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "x-openbooks-page": true,
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "email",
                          "role"
                        ],
                        "properties": {
                          "email": {
                            "type": "string",
                            "format": "email",
                            "description": "The address the member was added by."
                          },
                          "user": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 1,
                            "description": "The user id they signed in with, once they have."
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "owner",
                              "accountant",
                              "staff",
                              "viewer"
                            ],
                            "description": "Their role in the company."
                          }
                        }
                      },
                      "description": "This page's items, in order."
                    },
                    "next": {
                      "type": "string",
                      "description": "The cursor to pass as after for the next page; absent on the last."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/books/{org}/member.add": {
      "post": {
        "operationId": "member.add",
        "description": "Adds a person by email with a role.",
        "x-openbooks-word": "own",
        "x-openbooks-tool": false,
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The company the operation is on.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "The caller's key for this create: the same key and body get the first answer, another body a 409.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "What to write.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The address they will sign in with."
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "accountant",
                      "staff",
                      "viewer"
                    ],
                    "description": "The role they get."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Done, with nothing to answer."
          },
          "409": {
            "description": "The key was sent with another body."
          }
        }
      }
    },
    "/books/{org}/member.role": {
      "post": {
        "operationId": "member.role",
        "description": "Gives a member another role; the last owner stays one.",
        "x-openbooks-word": "own",
        "x-openbooks-tool": false,
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The company the operation is on.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "description": "What to write.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The member's address."
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "accountant",
                      "staff",
                      "viewer"
                    ],
                    "description": "Their new role."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Done, with nothing to answer."
          }
        }
      }
    },
    "/books/{org}/member.remove": {
      "post": {
        "operationId": "member.remove",
        "description": "Takes a member off the list; the last owner stays.",
        "x-openbooks-word": "own",
        "x-openbooks-tool": false,
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The company the operation is on.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "description": "What to write.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The member's address."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Done, with nothing to answer."
          }
        }
      }
    },
    "/books/{org}/audit": {
      "get": {
        "operationId": "audit",
        "description": "Lists the company's audit rows, oldest first, a page at a time.",
        "x-openbooks-word": "approve",
        "x-openbooks-tool": false,
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The company the operation is on.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "record",
            "in": "query",
            "required": false,
            "description": "Only the rows on this record, by its key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user",
            "in": "query",
            "required": false,
            "description": "Only the changes made for this person.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "description": "Only this kind of change.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Only the changes saved at or after this time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "description": "Only the changes saved before this time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "The cursor from the last page's next; absent for the first page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "x-openbooks-page": true,
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "seq",
                          "id",
                          "at",
                          "user",
                          "via",
                          "action",
                          "record",
                          "detail"
                        ],
                        "properties": {
                          "seq": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 1,
                            "description": "The row's place in the company's log."
                          },
                          "id": {
                            "type": "string",
                            "description": "The id the host gave the change."
                          },
                          "at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the change was saved."
                          },
                          "user": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 1,
                            "description": "The person the change was made for."
                          },
                          "via": {
                            "type": "string",
                            "description": "Who made it: person, assistant, host, pack or schedule."
                          },
                          "action": {
                            "type": "string",
                            "description": "The kind of change, as the operation names it."
                          },
                          "record": {
                            "type": "string",
                            "description": "The record it changed, as its key."
                          },
                          "detail": {
                            "type": "string",
                            "description": "What the change said."
                          },
                          "before": {
                            "type": "string",
                            "x-openbooks-tier": "never",
                            "description": "The record before, as JSON; absent if it is new."
                          },
                          "after": {
                            "type": "string",
                            "x-openbooks-tier": "never",
                            "description": "The record after, as JSON; absent if it is gone."
                          }
                        }
                      },
                      "description": "This page's items, in order."
                    },
                    "next": {
                      "type": "string",
                      "description": "The cursor to pass as after for the next page; absent on the last."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
